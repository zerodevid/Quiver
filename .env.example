# Quiver — secrets. Copy to .env then fill in:   cp .env.example .env && chmod 600 .env
# .env is NOT in git and NOT shipped by deploy.sh; create it yourself on every machine.
# Values here override config.json and are never written back to it.
# A line left empty has no effect.

# The bot wallet's private key (64 hex, may start with 0x). If set, the file
# wallet.key_file (~/.lpcopy/key) is ignored and the replace/detach wallet buttons on the
# dashboard are disabled. chmod 600 is required — the bot refuses to run if the permissions are loose.
LPCOPY_PRIVATE_KEY=

# Solana wallet key (ed25519) — base58 as exported by Phantom/Solflare, or the JSON
# [..] array from solana-keygen. Separate from the EVM key above. When set, the
# wallet.solana_key_file (~/.lpcopy/solana-key) file is ignored.
LPCOPY_SOLANA_PRIVATE_KEY=

# Dashboard sign-in token (server.auth_token). Empty = use the one in config.json.
LPCOPY_AUTH_TOKEN=

# Telegram bot token from @BotFather (telegram.bot_token).
LPCOPY_TELEGRAM_BOT_TOKEN=

# ntfy.sh topic for phone notifications (notify.ntfy_topic).
LPCOPY_NTFY_TOPIC=

# GMGN OpenAPI key (gmgn.api_key) — create at https://gmgn.ai/ai. Used for
# the GMGN price candles in the Chart tab. Empty = GeckoTerminal only.
LPCOPY_GMGN_API_KEY=

# Dashboard URL from outside (cloudflared tunnel), e.g. https://lp.example.com — deliberately not
# written in the repo so it is not published. Used by deploy.sh to print the address
# after deploy AND by the "Mini app" button in the Telegram bot (server.public_url); Telegram
# only accepts https. One VPS with several instances: may be per folder, e.g.
# LPCOPY_DASHBOARD_URL_LPCOPY2=https://lp2.example.com for ~/lpcopy2.
LPCOPY_DASHBOARD_URL=

# RPC API keys. Reference from config.json as ${NAME}, for example:
#   "url": "https://robinhood-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}"
#   "headers": { "x-api-key": "${RPC_KEY}" }
ALCHEMY_KEY=
# RPC Solana berkunci, mis. "https://mainnet.helius-rpc.com/?api-key=${HELIUS_KEY}"
# di chains.solana.chain.endpoints (taruh paling atas).
HELIUS_KEY=
# Opsional: API key Jupiter (api.jup.ag); kosong = lite-api.jup.ag (dibatasi laju).
JUPITER_API_KEY=

# Optional: another config location.
# LPCOPY_CONFIG=/path/to/config.json

# Optional Blockscout Pro API key for token holder distribution (Robinhood 4663).
BLOCKSCOUT_API_KEY=

# Optional swap aggregators (src/aggregators/, Settings → Aggregators). Keys can also be
# entered in the dashboard; a value here wins and is shown there as "from .env".
# OKX: create a key at web3.okx.com → Developer Portal. The first three are needed; project id optional.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=
# LI.FI works without a key (tight rate limit); 0x, 1inch and OpenOcean need one.
LIFI_API_KEY=
ZEROX_API_KEY=
ONEINCH_API_KEY=
OPENOCEAN_API_KEY=
