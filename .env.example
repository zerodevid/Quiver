# Quiver — rahasia. Salin ke .env lalu isi:   cp .env.example .env && chmod 600 .env
# .env TIDAK masuk git dan TIDAK ikut deploy.sh; buat sendiri di setiap mesin.
# Nilai di sini mengalahkan config.json dan tidak pernah ditulis balik ke sana.
# Baris yang dibiarkan kosong tidak berpengaruh.

# Kunci privat wallet bot (64 hex, boleh diawali 0x). Kalau diisi, berkas
# wallet.key_file (~/.lpcopy/key) diabaikan dan tombol ganti/lepas wallet di
# dasbor dinonaktifkan. Wajib chmod 600 — bot menolak jalan kalau izinnya longgar.
LPCOPY_PRIVATE_KEY=

# Token masuk dasbor (server.auth_token). Kosong = pakai yang di config.json.
LPCOPY_AUTH_TOKEN=

# Token bot Telegram dari @BotFather (telegram.bot_token).
LPCOPY_TELEGRAM_BOT_TOKEN=

# Topik ntfy.sh untuk notifikasi HP (notify.ntfy_topic).
LPCOPY_NTFY_TOPIC=

# URL dasbor (tunnel cloudflared). Hanya dipakai deploy.sh untuk mencetak alamat
# setelah deploy — sengaja tidak ditulis di repo supaya tidak ikut terpublikasi.
LPCOPY_DASHBOARD_URL=

# API key RPC. Rujuk dari config.json sebagai ${NAMA}, misalnya:
#   "url": "https://robinhood-mainnet.g.alchemy.com/v2/${ALCHEMY_KEY}"
#   "headers": { "x-api-key": "${RPC_KEY}" }
ALCHEMY_KEY=

# Opsional: lokasi config lain.
# LPCOPY_CONFIG=/path/ke/config.json
